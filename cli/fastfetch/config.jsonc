{
	"$schema":"https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

	"display":{
		"separator":"",
		"percent":{
			"type":["num","bar"]
		},
			"bar":{
				"width":10,
				"border":{
				"left":"",
				"right":""
			}
		}
	},	

	"logo":{
		"source":"~/.config/fastfetch/arch.txt",
		"padding":{
			"top":1,
			"right":3,
			"left":3
		}
	},

	"modules":[

		{
			"type":"custom",
			"format":"╭───────────────────────────────────────────────────────────────╮"
		},

		{
			"type":"os",
			"key":"│  OS           ",
			"format":"{pretty-name<48}│"
		},

		{
			"type":"command",
			"key":"│  Kernel       ",
			"text":"uname -r | cut -d '-' -f1",
			"format":"{result<48}│"
		},

		{
			"type":"command",
			"key":"│  Uptime       ",
			"text":"uptime -p | sed -E 's/up //; s/ days?/d/g; s/ hours?/h/g; s/ minutes?/m/g'",
			"format":"{result<48}│"
		},

		{
			"type":"shell",
			"key":"│  Shell        ",
			"format":"{pretty-name<48}│"
		},

		{
			"type":"command",
			"key":"│  WM           ",
			"text":"echo $XDG_CURRENT_DESKTOP",
			"format":"{result<48}│"
		},

		{
			"type":"command",
			"key":"│  Mem          ",
			"text":"free -m | awk 'NR==2{printf \"%.2f / %.2f GiB\",$3/1024,$2/1024}'",
			"format":"{result<48}│"
		},

		{
			"type":"command",
			"key":"│  CPU          ",
			"text":"lscpu | awk -F': *' '/Model name/ {name=$2} /Core\\(s\\) per socket/ {cores=$2} /CPU max MHz/ {freq=$2} END {printf \"%s | %s @ %.1f GHz\", name, cores, freq/1000}'",
			"format":"{result<48}│"
		},

		{
			"type":"command",
			"key":"│  Disk         ",
			"text":"df -h --output=size,used,fstype / | awk 'NR==2 {gsub(/G/,\"\",$1); gsub(/G/,\"\",$2); print $2 \" / \" $1 \" GiB - \" $3}'",
			"format":"{result<48}│"
		},

		{
			"type":"battery",
			"key":"│  Batt         ",
			"format":"{capacity-bar} {capacity} | {status<31}│"
		},

		{
     			"type": "display",
			"key": "│  Disp         ",
   			"format": "{width}x{height} @ {refresh-rate}Hz | {status<48}│"
    },

		{
			"type":"packages",
			"key":"│  Packages     ",
			"format":"{all<48}│"
		},

		{
			"type":"custom",
			"format":"╰───────────────────────────────────────────────────────────────╯"
		},

		"break"
	]
}
