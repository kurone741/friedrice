{
	"reload_config_on_change": false,
	"reload_style_on_change": true,
	"layer": "top",
	"position":"top",
	"height": 12,
	"margin-top": 2,
	"margin-left": 5,
	"margin-right": 5,
	"border-radius": 3,
	"spacing": 10,
	
	//module layouts
	"modules-left":["clock", "pulseaudio"],
	"modules-center":["hyprland/workspaces"],
	"modules-right":[
		"tray",
		"cpu",
		"memory",
		"battery"
	],

	//clock/date
	"clock": {
		"format": " {:%H:%M:%S %Y-%m-%d}",
		"interval":1
	},

	//pulseaudio
	"pulseaudio":{
		"format":"{icon} {volume}%",
		"format-icons":{
			"default":["", "", ""]
		},
		"on-click": "pavucontrol"
	},

	//workspaces
	"hyprland/workspaces":{
		"format": "{name}",
		"on-click": "activate"
	},

	//tray
	"tray":{
		"icon-size": 16,
		"spacing":12
	},

	//batt
	"battery":{
		"bat": "BAT0"
	},

	//mem usage
	"memory": {
		"interval":1,
		"format": "{used:0.1f}G/{total:0.1f}G"
	},

	//cpu usage
	"cpu": {
		"format": " {usage}%"
	}
}
